{
    "name": "nermif/logs",
    "description": "A coroutine-safe JSON line logger with request tracing and a built-in HTML timeline viewer.",
    "keywords": [
        "php",
        "redis",
        "stock"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Nermif\\Logs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nermif\\Logs\\Tests\\": "tests/"
        },
        "files": [
            "tests/support/TestSupport.php"
        ]
    },
    "authors": [
        {
            "name": "Nermif",
            "email": "cxal@outlook.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ramsey/uuid": "^4.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "test": "phpunit"
    }
}
